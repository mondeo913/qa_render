[Unit]
Description=SIGET web, API, PostgreSQL, colas y calendario
Requires=docker.service
After=docker.service network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/srv/siget/repository /srv/siget/backups

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@RELEASE_DIR@
ExecStart=/usr/bin/bash @RELEASE_DIR@/deploy/vm1/start.sh
ExecStop=/usr/bin/docker compose --env-file @RELEASE_DIR@/deploy/vm1/.env.production -f @RELEASE_DIR@/deploy/vm1/compose.yml stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
