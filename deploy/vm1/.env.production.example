APP_NAME=SIGET
APP_ENV=production
APP_DEBUG=false
APP_URL=https://siget.institucion.gob.mx
APP_KEY=
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=siget
DB_USERNAME=siget
DB_PASSWORD=
SIGET_DATABASE_ADMIN_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=nas
SIGET_REPOSITORY_DISK=nas
NAS_ROOT=/mnt/siget
SIGET_REPOSITORY_PATH=/srv/siget/repository
SIGET_REQUIRE_PRIVATE_REPOSITORY=true
SIGET_REPOSITORY_ID=
SIGET_BACKUP_PATH=/srv/siget/backups
SIGET_BACKUP_DIRECTORY=/backups
SIGET_BACKUP_MIN_FREE_GB=5
SIGET_BACKUP_DAY=1
SIGET_ANTIVIRUS_ENABLED=true
SIGET_ANTIVIRUS_COMMAND=clamdscan
SIGET_API_TOKEN_MINUTES=480
SIGET_API_LOGIN_PER_MINUTE=5
SIGET_API_REQUESTS_PER_MINUTE=120
SIGET_METRICS_TOKEN=
SIGET_TLS_PATH=/etc/siget/tls

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SIGET
SIGET_SUPPORT_EMAIL=
SIGET_ACCOUNTING_RECIPIENTS=

SIGET_APP_IMAGE=siget-app:1.0.0-api-v1
SIGET_WEB_IMAGE=siget-web:1.0.0-api-v1
SIGET_DATABASE_IMAGE=postgres:16-bookworm
SIGET_ANTIVIRUS_IMAGE=siget-antivirus:1.0.0-api-v1
