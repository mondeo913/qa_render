FROM mcr.microsoft.com/devcontainers/php:1-8.3-bookworm

ARG MAILPIT_VERSION=v1.30.6

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_PROCESS_TIMEOUT=1200

# Limpiar repositorios externos heredados que pueden romper apt.
RUN rm -f \
      /etc/apt/sources.list.d/yarn.list \
      /etc/apt/sources.list.d/yarnpkg.list \
      /etc/apt/sources.list.d/yarn*.list \
    || true

# Dependencias del ambiente SIGET K2.
# PostgreSQL server is included because the K2 startup scripts manage a local
# PostgreSQL instance on 127.0.0.1:5432 inside the dev container.
RUN apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libonig-dev \
        libpng-dev \
        libpq-dev \
        libzip-dev \
        postgresql \
        postgresql-client \
        procps \
        supervisor \
        unzip \
        zip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        gd \
        intl \
        mbstring \
        opcache \
        pdo_pgsql \
        pgsql \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Composer 2.
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
RUN chmod 0755 /usr/local/bin/composer \
    && composer --version

# Mailpit.
RUN set -eux; \
    architecture="$(dpkg --print-architecture)"; \
    case "${architecture}" in \
      amd64) mailpit_arch="amd64" ;; \
      arm64) mailpit_arch="arm64" ;; \
      *) echo "Arquitectura no soportada: ${architecture}" >&2; exit 1 ;; \
    esac; \
    mailpit_url="https://github.com/axllent/mailpit/releases/download/${MAILPIT_VERSION}/mailpit-linux-${mailpit_arch}.tar.gz"; \
    curl -fL --retry 6 --retry-all-errors --retry-delay 3 \
      "${mailpit_url}" -o /tmp/mailpit.tar.gz; \
    tar -xzf /tmp/mailpit.tar.gz -C /usr/local/bin mailpit; \
    chmod 0755 /usr/local/bin/mailpit; \
    /usr/local/bin/mailpit version; \
    rm -f /tmp/mailpit.tar.gz

# Configuracion PHP SIGET.
COPY .devcontainer/php.ini /usr/local/etc/php/conf.d/99-siget-codespaces.ini

USER vscode
